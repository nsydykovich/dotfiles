@@ -337,6 +337,12 @@ while [[ $# -gt 0 ]]; do
       shift
       for variant in $@; do
         case "$variant" in
+          aliens)
+            colorscheme='true'
+            schemes+=("${SCHEME_VARIANTS[6]}")
+            echo -e "\nAncientAliens ColorScheme version! ..."
+            shift
+            ;;
           nord)
             colorscheme='true'
             schemes+=("${SCHEME_VARIANTS[1]}")
@@ -474,6 +480,9 @@ compact_size() {
 color_schemes() {
   if [[ "$scheme" != '' ]]; then
     case "$scheme" in
+      -Aliens)
+        scheme_color='aliens'
+        ;;
       -Nord)
         scheme_color='nord'
         ;;
