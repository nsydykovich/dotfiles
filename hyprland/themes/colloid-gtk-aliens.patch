diff --git a/src/sass/_color-palette-aliens.scss b/src/sass/_color-palette-aliens.scss
new file mode 100644
index 0000000..37d3bfc
--- /dev/null
+++ b/src/sass/_color-palette-aliens.scss
@@ -0,0 +1,74 @@
+// AncientAliens Color Palette (rice: ~/rice, палитра совпадает с noctalia/palettes/AncientAliens.json)
+// Тёмный вариант: grey-700 = фон окна = surface Noctalia (#09111c), grey-650 = карточки = surface_container Noctalia (#13202d),
+// grey-750 = заголовки/сайдбар (чуть темнее фона), *-light = акценты
+
+// Red
+$red-light: #e88a8a;
+$red-dark: #c25f62;
+
+// Pink
+$pink-light: #e0a9c8;
+$pink-dark: #b9789c;
+
+// Purple
+$purple-light: #a9b4e8;
+$purple-dark: #6f7cc0;
+
+// Blue
+$blue-light: #aad5f0;
+$blue-dark: #4f87ad;
+
+// Teal
+$teal-light: #7fd0e0;
+$teal-dark: #3c97a8;
+
+// Green
+$green-light: #9fd4b0;
+$green-dark: #5a9a6f;
+
+// Yellow
+$yellow-light: #e6cf94;
+$yellow-dark: #b89a4e;
+
+// Orange
+$orange-light: #e8a87c;
+$orange-dark: #c07a4c;
+
+// Grey (стальная синева)
+$grey-050: #f6f9fb;
+$grey-100: #edf3f8;
+$grey-150: #e3edf5;
+$grey-200: #d6e6f2;
+$grey-250: #c3d2de;
+$grey-300: #a9bccb;
+$grey-350: #8fa6b8;
+$grey-400: #6b8799;
+$grey-450: #507284;
+$grey-500: #3e5c70;
+$grey-550: #2d485b;
+$grey-600: #1c2d3d;
+$grey-650: #13202d;
+$grey-700: #09111c;
+$grey-750: #070f19;
+$grey-800: #060c15;
+$grey-850: #050a12;
+$grey-900: #04080e;
+$grey-950: #03060a;
+
+// White (чуть голубоватый, как текст в AncientAliens)
+$white: #eef5fa;
+
+// Black
+$black: #000000;
+
+// Button
+$button-close: #e88a8a;
+$button-max: #9fd4b0;
+$button-min: #e6cf94;
+
+// Link
+$links: #7fd0e0;
+
+// Theme
+$default-light: $blue-light;
+$default-dark: $blue-dark;
