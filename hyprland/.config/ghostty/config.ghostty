# Font Configuration
font-size = 10.75
font-family = "JetBrainsMono Nerd Font"
font-feature = +liga
font-feature = +calt
font-feature = +dlig

# Window Configuration
window-decoration = false
window-padding-x = 4
window-padding-y = 4
background-opacity = 0.5
background-blur = true

# Cursor Configuration (underline везде, shell integration не трогает курсор)
cursor-style = underline

# Scrollback
scrollback-limit = 3023

# Terminal features
mouse-hide-while-typing = true
copy-on-select = false
confirm-close-surface = false

# Disable annoying copied to clipboard
app-notifications = no-clipboard-copy,no-config-reload

# Key bindings for common actions
#keybind = ctrl+c=copy_to_clipboard
#keybind = ctrl+v=paste_from_clipboard
keybind = ctrl+shift+n=new_window
keybind = ctrl+t=new_tab
keybind = ctrl+plus=increase_font_size:1
keybind = ctrl+minus=decrease_font_size:1
keybind = ctrl+zero=reset_font_size

# Material 3 UI elements
unfocused-split-opacity = 0.7
unfocused-split-fill = #44464f

# Tab configuration
gtk-titlebar = true

# Shell integration
shell-integration = detect
shell-integration-features = sudo,title,no-cursor
keybind = shift+enter=text:\n

# Rando stuff
gtk-single-instance = true
quit-after-last-window-closed = false

# Dank color generation
theme = noctalia

# Новые окна открываются в $HOME, а не в cwd последнего фокусного окна
working-directory = home
window-inherit-working-directory = false
